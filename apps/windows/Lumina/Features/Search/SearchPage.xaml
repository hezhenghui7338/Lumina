<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lumina.Features.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lumina.Services">
    <Grid Padding="24" MaxWidth="720" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="搜索" FontSize="28" FontWeight="SemiBold"/>
            <Button Content="关闭" HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
        <TextBox x:Name="QueryBox" Grid.Row="1" PlaceholderText="搜索书籍、段落、笔记…"
                 KeyDown="QueryBox_KeyDown" Margin="0,0,0,12"/>
        <Grid Grid.Row="2">
            <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ListView x:Name="ResultsList" IsItemClickEnabled="True" ItemClick="Results_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SearchHit">
                        <StackPanel Padding="8,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind KindLabel}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Snippet}" FontSize="12" TextWrapping="WrapWholeWords"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
