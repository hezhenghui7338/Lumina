<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lumina.Features.Library.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lumina.Services">
    <NavigationView
        x:Name="CollectionNav"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Left"
        OpenPaneLength="220"
        IsPaneToggleButtonVisible="True"
        SelectionChanged="CollectionNav_SelectionChanged">
        <Grid Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TitleText" Text="最近" FontSize="28" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="全部笔记" Click="AllNotes_Click"/>
                    <Button Content="刷新" Click="Refresh_Click"/>
                    <Button Content="导入" Style="{StaticResource AccentButtonStyle}" Click="Import_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <TextBox x:Name="TitleFilterBox" Header="筛选书名" Width="200"
                         PlaceholderText="书名" TextChanged="TitleFilter_Changed"/>
                <ComboBox x:Name="SortBox" Header="排序" Width="140" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="最近访问" Tag="recent" IsSelected="True"/>
                    <ComboBoxItem Content="添加时间" Tag="added"/>
                    <ComboBoxItem Content="标题" Tag="title"/>
                    <ComboBoxItem Content="段落数" Tag="segments"/>
                    <ComboBoxItem Content="收藏优先" Tag="favorite"/>
                </ComboBox>
                <ComboBox x:Name="ViewModeBox" Header="视图" Width="120" SelectionChanged="ViewMode_Changed">
                    <ComboBoxItem Content="网格" Tag="grid" IsSelected="True"/>
                    <ComboBoxItem Content="列表" Tag="list"/>
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="BatchBar" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="BatchCountText" VerticalAlignment="Center"/>
                <Button Content="收藏" Click="BatchFavorite_Click"/>
                <Button Content="取消收藏" Click="BatchUnfavorite_Click"/>
                <ComboBox x:Name="BatchSummaryTierBox" Width="110" SelectedIndex="0"
                          ToolTipService.ToolTip="开始摘要只处理未摘要段落，不会覆盖已有摘要">
                    <ComboBoxItem Content="正常摘要" Tag="normal"/>
                    <ComboBoxItem Content="高级摘要" Tag="advanced"/>
                </ComboBox>
                <Button Content="开始摘要" Click="BatchSummarize_Click"
                        ToolTipService.ToolTip="仅处理尚未摘要的段落"/>
                <Button Content="停止摘要" Click="BatchStop_Click"/>
                <Button Content="删除" Click="BatchDelete_Click"/>
                <Button Content="取消选择" Click="ClearSelection_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,0,0,8"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Grid Grid.Row="4">
                <ProgressRing x:Name="LoadingRing" Width="40" Height="40"
                              IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <GridView x:Name="BooksGrid"
                          IsItemClickEnabled="True"
                          ItemClick="BooksList_ItemClick"
                          SelectionMode="Multiple"
                          SelectionChanged="BooksList_SelectionChanged">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:BookSummary">
                            <StackPanel Width="148" Padding="8">
                                <Border Height="176" CornerRadius="8"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind CoverInitial}" FontSize="32" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="WrapWholeWords" MaxLines="2"/>
                                    <TextBlock Text="{x:Bind FavoriteMark}" Foreground="Goldenrod"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind CardStatusLine}" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" MaxLines="2"/>
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind SegmentCountLabel}"/>
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind Category}"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                                    <Button Content="☆" Tag="{x:Bind Id}" Click="Favorite_Click" ToolTipService.ToolTip="收藏"/>
                                    <Button Content="⋯" Tag="{x:Bind Id}" Click="More_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <ListView x:Name="BooksList"
                          Visibility="Collapsed"
                          IsItemClickEnabled="True"
                          ItemClick="BooksList_ItemClick"
                          SelectionMode="Multiple"
                          SelectionChanged="BooksList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BookSummary">
                            <Grid Padding="8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="WrapWholeWords"/>
                                        <TextBlock Text="{x:Bind FavoriteMark}" Foreground="Goldenrod"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind CardStatusLine}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind SegmentCountLabel}"/>
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind Category}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="☆" Tag="{x:Bind Id}" Click="Favorite_Click" ToolTipService.ToolTip="收藏"/>
                                    <Button Content="⋯" Tag="{x:Bind Id}" Click="More_Click"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
