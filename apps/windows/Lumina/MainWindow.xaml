<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lumina.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lumina">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Lumina" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EngineStatusText" Text="引擎启动中…" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <NavigationView x:Name="NavView"
                                Grid.Column="1"
                                PaneDisplayMode="Top"
                                IsSettingsVisible="False"
                                IsBackButtonVisible="Collapsed"
                                SelectionChanged="NavView_SelectionChanged">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="书库" Tag="library" IsSelected="True"/>
                        <NavigationViewItem Content="资讯" Tag="news"/>
                        <NavigationViewItem Content="设置" Tag="settings"/>
                    </NavigationView.MenuItems>
                </NavigationView>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="搜索 Ctrl+K" Click="Search_Click"/>
                    <Button Content="重试引擎" Click="RetryEngine_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1"/>

        <!-- Brand splash overlay (PRD §3.5): bouncing logo only -->
        <Grid x:Name="ColdStartOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.72"/>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        Spacing="20"
                        Padding="24">
                <Grid Width="200" Height="90" HorizontalAlignment="Center">
                    <Ellipse x:Name="ColdStartLandingGlow"
                             Width="88" Height="14"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,4"
                             Opacity="0.35">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.45"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="ColdStartBrand"
                               Text="Lumina"
                               FontSize="36"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,1">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="ColdStartBrandOffset" Y="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
                <StackPanel x:Name="ColdStartDetailPanel"
                            Spacing="10"
                            Visibility="Collapsed">
                    <TextBlock x:Name="ColdStartDetailText"
                               Text=""
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="WrapWholeWords"/>
                    <TextBlock x:Name="ColdStartElapsedText"
                               Text="已用时 0 秒"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Button x:Name="ColdStartRetryButton"
                                Content="重试"
                                Click="RetryEngine_Click"
                                Visibility="Collapsed"/>
                        <Button Content="退出" Click="ColdStartExit_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TeachingTip x:Name="OnboardingTip"
                     Title="导入书籍"
                     IsLightDismissEnabled="False"
                     PreferredPlacement="Bottom"
                     CloseButtonContent="跳过引导"
                     ActionButtonContent="下一步"
                     ActionButtonClick="OnboardingNext_Click"
                     CloseButtonClick="OnboardingSkip_Click"
                     Closed="OnboardingTip_Closed">
            <TeachingTip.Content>
                <HyperlinkButton x:Name="OnboardingBackButton" Content="上一步"
                                 Click="OnboardingBack_Click"/>
            </TeachingTip.Content>
        </TeachingTip>
    </Grid>
</Window>
