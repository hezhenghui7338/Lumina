<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lumina.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lumina">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Lumina" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EngineStatusText" Text="引擎启动中…" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <NavigationView x:Name="NavView"
                                Grid.Column="1"
                                PaneDisplayMode="Top"
                                IsSettingsVisible="False"
                                IsBackButtonVisible="Collapsed"
                                SelectionChanged="NavView_SelectionChanged">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="书库" Tag="library" IsSelected="True"/>
                        <NavigationViewItem Content="资讯" Tag="news"/>
                        <NavigationViewItem Content="设置" Tag="settings"/>
                    </NavigationView.MenuItems>
                </NavigationView>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="搜索 Ctrl+K" Click="Search_Click"/>
                    <Button Content="重试引擎" Click="RetryEngine_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1"/>
    </Grid>
</Window>
